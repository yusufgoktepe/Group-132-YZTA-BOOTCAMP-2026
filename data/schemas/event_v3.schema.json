{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campusmatch.event.v3",
  "title": "CampusMatch Event V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "schema_version", "organizer_id", "event_tier", "title",
    "description", "category_id", "interest_ids", "target_program_ids",
    "target_class_years", "target_goal_ids", "event_type", "starts_at",
    "participation_mode", "fee_type", "quota", "language", "status",
    "approval_status", "organizer_trust_score"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "3.0" },
    "organizer_id": { "type": "string", "minLength": 1 },
    "event_tier": { "enum": ["official", "micro"] },
    "university_id": { "type": ["string", "null"] },
    "campus_id": { "type": ["string", "null"] },
    "city_id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "category_id": { "type": "string", "minLength": 1 },
    "interest_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "target_program_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "target_class_years": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(prep|[1-6])$" } },
    "target_goal_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "event_type": { "type": "string", "minLength": 1 },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "participation_mode": { "enum": ["onsite", "online", "hybrid"] },
    "location_name": { "type": ["string", "null"], "maxLength": 200 },
    "fee_type": { "enum": ["free", "paid"] },
    "fee_amount": { "type": ["number", "null"], "minimum": 0 },
    "quota": { "type": "integer", "minimum": 1 },
    "language": { "enum": ["tr", "en", "mixed"] },
    "status": { "enum": ["draft", "published", "full", "cancelled", "completed", "expired"] },
    "approval_status": { "enum": ["not_required", "pending", "approved", "rejected"] },
    "organizer_trust_score": { "type": "number", "minimum": 0, "maximum": 5 },
    "image_url": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "event_tier": { "const": "micro" } } },
      "then": {
        "required": ["expires_at", "location_name"],
        "properties": { "approval_status": { "const": "not_required" } }
      }
    },
    {
      "if": { "properties": { "event_tier": { "const": "official" } } },
      "then": { "properties": { "approval_status": { "enum": ["pending", "approved", "rejected"] } } }
    }
  ]
}
