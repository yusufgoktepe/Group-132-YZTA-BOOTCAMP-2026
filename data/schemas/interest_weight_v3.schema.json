{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campusmatch.interest-weight.v3",
  "title": "CampusMatch Dynamic Interest Weight V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "interest_id", "weight", "explicit_weight", "behavior_weight", "updated_at"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "interest_id": { "type": "string", "minLength": 1 },
    "weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "explicit_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "behavior_weight": { "type": "number", "minimum": -1, "maximum": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
